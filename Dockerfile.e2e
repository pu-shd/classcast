# Browser end-to-end tests (Chromium, WebKit, Firefox) for the UmbraCast page.
FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:2f05f8a734509a7b3f26a912639488ee08f58a7b292d14d62271bcff9038768f

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY playwright.config.js index.html create.html class-page.js create-page.js classcast.js styles.css ./
COPY vendor/paper-tiger ./vendor/paper-tiger
COPY e2e ./e2e

CMD ["npx", "playwright", "test"]
